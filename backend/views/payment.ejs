<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Fake Payment</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light p-4">
  <div class="container">
    <h3>Pay ₹<%= amount %></h3>
    <p>For ID: <strong><%= id %></strong></p>

    <div class="card p-3 mb-3">
      <label class="form-label">Name</label>
      <input id="name" class="form-control mb-2" placeholder="Your name"/>

      <label class="form-label">Payment method</label>
      <select id="method" class="form-select mb-2">
        <option value="card">Card</option>
        <option value="upi">UPI</option>
        <option value="wallet">Wallet</option>
      </select>

      <label class="form-label">Card number (fake)</label>
      <input id="card" class="form-control mb-3" placeholder="4111 1111 1111 1111"/>

      <div class="d-flex gap-2">
        <button id="payBtn" class="btn btn-primary">Pay Now</button>
        <button id="cancelBtn" class="btn btn-outline-secondary">Cancel</button>
      </div>
    </div>

    <div id="msg"></div>
  </div>

  <script>
    const payBtn = document.getElementById("payBtn");
    const cancelBtn = document.getElementById("cancelBtn");
    const msg = document.getElementById("msg");
    const id = "<%= id %>";

    payBtn.addEventListener("click", async () => {
      const name = document.getElementById("name").value || "Guest";
      const method = document.getElementById("method").value;
      const card = document.getElementById("card").value || "";

      payBtn.disabled = true;
      payBtn.innerText = "Processing...";

      const res = await fetch(`/pay/${id}/complete`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name, method, card })
      });

      if (res.redirected) {
        window.location = res.url;
        return;
      }

      const html = await res.text();
      document.open();
      document.write(html);
      document.close();
    });

    cancelBtn.addEventListener("click", async () => {
      await fetch(`/pay/${id}/cancel`, { method: "POST" });
      msg.innerHTML = '<div class="alert alert-warning">Payment cancelled (simulated).</div>';
    });
  </script>
</body>
</html>
