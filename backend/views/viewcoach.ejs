<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Coach Details</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    .btn-action {
      border-radius: 50px;
      padding: 0.6rem 1.5rem;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .btn-action:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 15px rgba(0,0,0,0.2);
    }
  </style>
</head>
<body class="bg-dark">

  <div class="container d-flex justify-content-center align-items-center" style="min-height:100vh;">
    <div class="card shadow-lg p-4 bg-info-subtle" style="width: 28rem; border-radius: 15px;">
      <h2 class="text-center mb-4 text-primary fw-bold">Coach Details</h2>

      <ul class="list-group list-group-flush ">
        <li class="list-group-item"><strong>Name:</strong> <%= coach.name %></li>
        <li class="list-group-item"><strong>Experience:</strong> <%= coach.experience %> years</li>
        <li class="list-group-item"><strong>Team:</strong> <%= coach.team %></li>
        <li class="list-group-item"><strong>Sport:</strong> <%= coach.sport %></li>
      </ul>

      <div class="d-flex justify-content-around mt-4">
        <a href="/pay/<%= coach._id %>" class="btn btn-success btn-action">Pay</a>
        <a href="/appointment/<%= coach._id %>" class="btn btn-primary btn-action">Appointment</a>
      </div>

      <div class="mt-3 text-center">
        <a href="/home" class="btn btn-secondary btn-sm">Back to Coaches</a>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
