<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Search Results</title>
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
   <!-- <link rel="stylesheet" href="/newcode.css"> -->
    
</head>
<body class="bg-black text-white">



  <div class="container my-5">
    
    <!-- Search Bar -->
    <form class="d-flex justify-content-center mb-5" role="search" action="/search" method="get">
      <input 
        class="form-control w-50 me-2 shadow-sm rounded-pill px-3" 
        type="search" 
        name="q" 
        placeholder="Search for Cricket or Football Coaches" 
        aria-label="Search" 
        value="<%= typeof q !== 'undefined' ? q : '' %>"
      />
      <button class="btn btn-primary rounded-pill px-4 shadow-sm" type="submit">Search</button>
    </form>
 
    <!-- Title -->
    <h1 class="text-center text-primary mb-4">
      <%= sport ? sport + " Coaches" : "Search Results" %>
    </h1>

    <!-- Results -->
      <div class="">
  <% if (coaches && coaches.length > 0) { %>
    <div class="row g-3">
      <% coaches.forEach(coach => { %>
        <div class="col-md-4">
          <div class="card shadow-lg border-0 rounded-4 h-100  bg-dark text-white">
            <!-- Everything INSIDE card-body -->
            <div class="card-body text-center">
              <img src="<%= coach.coachImage %>" 
     alt="Coach Image" 
     class="img-fluid rounded mb-3"
     style="height: 200px; width: 100%; object-fit: cover;">

              <h5 class="card-title text-primary fw-bold"><%= coach.name %></h5>
              <p class="card-text mb-2"><strong>Experience:</strong> <%= coach.experience %> years</p>
              <p class="card-text mb-4"><strong>Team:</strong> <%= coach.team %></p>
              <p class="card-text mb-4"><strong>sport:</strong> <%= coach.sport %></p>

              <a href="/viewcoach/<%=coach._id%>" class="btn btn-outline-primary btn-sm rounded-pill px-3">View</a>

              <% if(curruser && curruser._id.equals(coach.owner)){ %>
              <a href="" class="btn btn-outline-warning btn-sm rounded-pill px-3">Edit</a>

                <%}%>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="alert alert-warning text-center mt-5">No coaches found. </div>
  <% } %>
</div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
