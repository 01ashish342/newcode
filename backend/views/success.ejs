<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Payment Success</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="p-4">
  <div class="container">
    <div class="alert alert-success">
      <h4>Payment Successful ✅</h4>
      <p>Payment ID: <strong><%= payment.payment_id %></strong></p>
      <p>Booking/Order ID: <strong><%= payment.booking_id %></strong></p>
      <p>Amount: ₹<strong><%= payment.amount %></strong></p>
      <p>Status: <strong><%= payment.status %></strong></p>
      <p>Time: <%= payment.createdAt.toLocaleString() %></p>
    </div>
    <a href="/home" class="btn btn-secondary">Back home</a>
  </div>
</body>
</html>
