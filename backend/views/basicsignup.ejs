<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Signup Page</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    /* Optional: Gradient buttons for a modern look */
    .btn-player {
      background: linear-gradient(45deg, #0d6efd, #6610f2);
      color: white;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .btn-player:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 20px rgba(0,0,0,0.2);
    }

    .btn-coach {
      background: linear-gradient(45deg, #198754, #20c997);
      color: white;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .btn-coach:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 20px rgba(0,0,0,0.2);
    }

    body {
      background: #f8f9fa; /* light gray background */
    }
  </style>
</head>
<body class="bg-info-subtle">

  <div class="d-flex justify-content-center align-items-center vh-100">
    <div class="text-center">
      <h1 class="mb-4 fw-bold">Sign Up</h1>
      <p class="mb-5 text-muted">Choose your role to create your account</p>
      <div class="d-flex justify-content-center gap-4 flex-wrap">

        <!-- Signup as Player -->
        <a href="/signup/player" class="btn btn-player btn-lg px-5 py-3 rounded-pill shadow">
          Signup as Player
        </a>

        <!-- Signup as Coach -->
        <a href="/signup/coach" class="btn btn-coach btn-lg px-5 py-3 rounded-pill shadow">
          Signup as Coach
