<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Requests</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background: slategray
    }
    .table-container {
      background: #fff;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
      padding: 20px;
    }
    .status-badge {
      font-size: 0.85rem;
      padding: 6px 12px;
      border-radius: 20px;
    }
    .status-pending {
      background-color: #ffc107;
      color: #212529;
    }
    .status-accepted {
      background-color: #28a745;
      color: #fff;
    }
    .status-rejected {
      background-color: #dc3545;
      color: #fff;
    }
    .action-btn {
      border-radius: 20px;
      font-size: 0.85rem;
      padding: 6px 16px;
      transition: all 0.2s ease-in-out;
    }
    .action-btn:hover {
      transform: scale(1.05);
    }
  </style>
</head>
<body>
  <div class="container mt-5">
    <h2 class="mb-4 text-center fw-bold text-dark">My Appointment Requests</h2>

 <div class="table-container">
  <% if (appointments.length === 0) { %>
    <p class="text-muted text-center">You haven’t requested any appointments yet.</p>
  <% } else { %>
    <div class="table-responsive">   <!-- ✅ makes table scrollable on phone -->
      <table class="table table-hover align-middle text-center">
        <thead class="table-dark">
          <tr>
            <th>Coach</th>
            <th>Date</th>
            <th>Time</th>
            <th>Reason</th>
            <th>Status</th>
            <th>Action</th>
            <th>livevideo status</th>
          </tr>
        </thead>
        <tbody>
          <% appointments.forEach(app => { %>
            <tr>
              <td><%= app.coach ? app.coach.name : "Unknown Coach" %></td>
              <td><%= app.date.toDateString() %></td>
              <td><%= app.time %></td>
              <td><%= app.reason %></td>
              <td>
                <% if (app.status === "pending") { %>
                  <span class="status-badge status-pending">Pending</span>
                <% } else if (app.status === "accepted") { %>
                  <span class="status-badge status-accepted">Accepted</span>
                <% } else { %>
                  <span class="status-badge status-rejected">Rejected</span>
                <% } %>
              </td>
              <td>
  <button class="btn btn-outline-primary action-btn">View Details</button>
  </td>
<td>
  <% if (app.status === 'accepted') { %>
    <% 
      const now = new Date();
      const appointmentTime = new Date(app.date);
      const [hours, minutes] = app.time.split(":");
      appointmentTime.setHours(hours);
      appointmentTime.setMinutes(minutes);
    %>
    
    <% if (appointmentTime <= now) { %>
      <% if (app.payment && app.payment.status === 'success') { %>
        <form action="/videocall/<%= app._id %>" method="GET">
          <button type="submit" class="btn btn-success action-btn">
            Start Video Call
          </button>
        </form>
      <% } else { %>
        <form action="/pay/<%= app._id %>" method="GET">
          <button type="submit" class="btn btn-warning action-btn">
            Pay Now ₹499
          </button>
        </form>
      <% } %>
    <% } else { %>
      <button class="btn btn-outline-warning action-btn" disabled>
        Wait until scheduled time
      </button>
    <% } %>
  <% } else { %>
    <button class="btn btn-outline-secondary action-btn" disabled>
      Appointment Not Accepted
    </button>
  <% } %>
</td>




            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

  </div>
</body>
</html>
