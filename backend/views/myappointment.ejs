<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Appointments</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-dark text-white">

<div class="container mt-5">
  <h2 class="mb-4">Appointments for <%= curruser.username %></h2>

  <% if (appointments.length === 0) { %>
    <p>No appointments yet.</p>
  <% } else { %>
    <table class="table table-striped">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Phone</th>
          <th>Date</th>
          <th>Time</th>
          <th>Reason</th>
          <th>status</th>
          <th>result</th>
           <th>join call</th>
        </tr>
      </thead>
      <tbody>
        <% appointments.forEach(app => { %>
          <tr>
            <td><%= app.name %></td> 
            <td><%= app.email %></td>
            <td><%= app.phone %></td>
            <td><%= app.date.toDateString() %></td>
            <td><%= app.time %></td>
            <td><%= app.reason %></td>
            
   <td>
  <% if (app.status === "pending") { %>
    <span class="text-warning">Pending</span>
  <% } else if (app.status === "accepted") { %>
    <span class="text-success">Accepted ✅</span>
  <% } else if (app.status === "rejected") { %>
    <span class="text-danger">Rejected ❌</span>
  <% } %>
</td>

<td>
  <% if (app.status === "pending") { %>
    <button class="btn btn-success" onclick="accept('<%= app._id %>')">ACCEPT</button>
  <% } else { %>
    <span class="text-muted">No Action</span>
  <% } %>
</td><td><a href="/coach/videocall/<%= app._id %>" class="btn btn-primary">Join Call</a>
</td>

          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
<script>
  function accept(id) {
    fetch(`/accept/${id}`, {
      method: "POST"
    })
    .then(res => res.json())
    .then(data => {
      alert(data.message); // show server response
    })
    .catch(err => console.error(err));
  }
</script>
</body>
</html>
