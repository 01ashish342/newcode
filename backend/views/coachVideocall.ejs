<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Coach Video Call with <%= appointment.name %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { display:flex; flex-direction:column; align-items:center; padding:20px; background:#f5f5f5; min-height:100vh; }
    h2 { margin-bottom:20px; text-align:center; }
    video { width:100%; max-width:600px; margin-bottom:20px; border-radius:12px; border:2px solid #333; background:#000; }
    .controls { display:flex; gap:10px; margin-bottom:20px; flex-wrap:wrap; justify-content:center; }
    .controls button { border-radius:50px; padding:10px 20px; font-size:1rem; cursor:pointer; }
    .btn-mute { background:#dc3545; color:#fff; }
    .btn-video { background:#007bff; color:#fff; } 
    .btn-end { background:#6c757d; color:#fff; }
  </style>
</head>
<body class="bg-dark">
  <h2>Coach Video Call with <%= appointment.name %></h2>
  <video id="localVideo" autoplay playsinline muted></video>
  <video id="remoteVideo" autoplay playsinline></video>

  <div class="controls">
    <button id="toggleAudio" class="btn-mute">Mute</button>
    <button id="toggleVideo" class="btn-video">Stop Video</button>
    <button id="endCall" class="btn-end">End Call</button>
  </div>

<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();
  const appointmentId = "<%= appointment._id %>";

  let pc = new RTCPeerConnection({
    iceServers: [{ urls: "stun:stun.l.google.com:19302" }]
  });

  const localVideo = document.getElementById("localVideo");
  const remoteVideo = document.getElementById("remoteVideo");
  const toggleAudioBtn = document.getElementById("toggleAudio");
  const toggleVideoBtn = document.getElementById("toggleVideo");
  const endCallBtn = document.getElementById("endCall");

  let localStream;

  // Get coach media
  async function initMedia() {
    try {
      localStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
      localVideo.srcObject = localStream;
      localStream.getTracks().forEach(track => pc.addTrack(track, localStream));
    } catch(err) {
      alert("Camera/Microphone error: " + err.message);
    }
  }

  initMedia();

  // When remote track arrives
  pc.ontrack = (e) => {
    remoteVideo.srcObject = e.streams[0];
  };

  // Send ICE candidates
  pc.onicecandidate = (e) => {
    if (e.candidate) {
      socket.emit("ice-candidate", { candidate: e.candidate, appointmentId });
    }
  };

  // Listen for player’s offer
  socket.on("offer", async (data) => {
    await pc.setRemoteDescription(new RTCSessionDescription(data.offer));
    const answer = await pc.createAnswer();
    await pc.setLocalDescription(answer);
    socket.emit("answer", { answer, appointmentId });
  });

  // Listen for ICE from player
  socket.on("ice-candidate", async (data) => {
    try { await pc.addIceCandidate(new RTCIceCandidate(data.candidate)); } 
    catch (err) { console.error(err); }
  });

  // Notify server coach is ready
  socket.emit("ready", { appointmentId });

  // Zoom-like controls
  toggleAudioBtn.onclick = () => {
    if (!localStream) return;
    localStream.getAudioTracks()[0].enabled = !localStream.getAudioTracks()[0].enabled;
    toggleAudioBtn.innerText = localStream.getAudioTracks()[0].enabled ? "Mute" : "Unmute";
  };

  toggleVideoBtn.onclick = () => {
    if (!localStream) return;
    localStream.getVideoTracks()[0].enabled = !localStream.getVideoTracks()[0].enabled;
    toggleVideoBtn.innerText = localStream.getVideoTracks()[0].enabled ? "Stop Video" : "Start Video";
  };

  endCallBtn.onclick = () => {
    if(localStream) localStream.getTracks().forEach(track => track.stop());
    if(pc) pc.close();
    window.location.href = "/myappointments";
  };

</script>
</body>
</html>
