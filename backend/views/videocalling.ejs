<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Video Call with <%= appointment.coach.name %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background: #121212;
      color: #fff;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      min-height: 100vh;
      padding: 20px;
    }

    h2 {
      margin-bottom: 20px;
      text-align: center;
    }

    .videos {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 15px;
      width: 100%;
      max-width: 800px;
    }

    video {
      border-radius: 12px;
      border: 2px solid #333;
      width: 100%;
      max-width: 720px;
      height: auto;
      background: #000;
    }

    .controls {
      margin-top: 15px;
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      justify-content: center;
    }

    .controls button {
      border-radius: 50px;
      padding: 10px 20px;
      font-size: 1rem;
      cursor: pointer;
    }

    .btn-mute { background: #dc3545; color: #fff; }
    .btn-video { background: #007bff; color: #fff; }
    .btn-end { background: #6c757d; color: #fff; }
  </style>
</head>
<body>
  <h2>Video Call with <%= appointment.coach.name %></h2>

  <div class="videos">
    <video id="localVideo" autoplay playsinline muted></video>
    <video id="remoteVideo" autoplay playsinline></video>
  </div>

  <div class="controls">
    <button id="toggleAudio" class="btn-mute">Mute</button>
    <button id="toggleVideo" class="btn-video">Stop Video</button>
    <button id="endCall" class="btn-end">End Call</button>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    const localVideo = document.getElementById("localVideo");
    const remoteVideo = document.getElementById("remoteVideo");
    const toggleAudioBtn = document.getElementById("toggleAudio");
    const toggleVideoBtn = document.getElementById("toggleVideo");
    const endCallBtn = document.getElementById("endCall");

    const socket = io();
    let localStream;
    let peerConnection;
    const config = { iceServers: [{ urls: "stun:stun.l.google.com:19302" }] };
    const appointmentId = "<%= appointment._id %>";

    async function startCall() {
      try {
        // HD video + audio
        localStream = await navigator.mediaDevices.getUserMedia({
          video: { width: 1280, height: 720 },
          audio: true
        });
        localVideo.srcObject = localStream;

        peerConnection = new RTCPeerConnection(config);

        localStream.getTracks().forEach(track => peerConnection.addTrack(track, localStream));

        peerConnection.ontrack = (event) => {
          remoteVideo.srcObject = event.streams[0];
        };

        peerConnection.onicecandidate = (event) => {
          if (event.candidate) {
            socket.emit("ice-candidate", { candidate: event.candidate, appointmentId });
          }
        };

        // Notify server ready
        socket.emit("ready", { appointmentId });

      } catch (err) {
        alert("Camera/Microphone access denied or error: " + err.message);
      }
    }

    startCall(); // start automatically, can also trigger on button click

    // Zoom-like controls
    toggleAudioBtn.onclick = () => {
      if (!localStream) return;
      localStream.getAudioTracks()[0].enabled = !localStream.getAudioTracks()[0].enabled;
      toggleAudioBtn.innerText = localStream.getAudioTracks()[0].enabled ? "Mute" : "Unmute";
    };

    toggleVideoBtn.onclick = () => {
      if (!localStream) return;
      localStream.getVideoTracks()[0].enabled = !localStream.getVideoTracks()[0].enabled;
      toggleVideoBtn.innerText = localStream.getVideoTracks()[0].enabled ? "Stop Video" : "Start Video";
    };

    endCallBtn.onclick = () => {
      if (localStream) localStream.getTracks().forEach(track => track.stop());
      if (peerConnection) peerConnection.close();
      window.location.href = "/home";
    };

    // Listen for offers
    socket.on("offer", async (data) => {
      if (!peerConnection) return;
      await peerConnection.setRemoteDescription(new RTCSessionDescription(data.offer));
      const answer = await peerConnection.createAnswer();
      await peerConnection.setLocalDescription(answer);
      socket.emit("answer", { answer, appointmentId });
    });

    // Listen for answers
    socket.on("answer", async (data) => {
      if (!peerConnection) return;
      await peerConnection.setRemoteDescription(new RTCSessionDescription(data.answer));
    });

    // Listen for ICE candidates
    socket.on("ice-candidate", async (data) => {
      try {
        if (!peerConnection) return;
        await peerConnection.addIceCandidate(new RTCIceCandidate(data.candidate));
      } catch (err) {
        console.error("Error adding received ice candidate", err);
      }
    });
  </script>
</body>
</html>
